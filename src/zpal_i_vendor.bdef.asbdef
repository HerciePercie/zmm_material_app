managed implementation in class zpal_bp_vendor unique;
strict ( 2 );
with draft;

define behavior for ZPAL_I_VENDOR alias Vendor
persistent table zpal_vendor
draft table zpal_vendor_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory : create ) VendorId, Name;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zpal_vendor
  {
    VendorId           = vendor_id;
    Name               = name;
    TaxNumber          = tax_number;
    VendorGroup        = vendor_group;
    Email              = email;
    Phone              = phone;
    Street             = street;
    City               = city;
    PostalCode         = postal_code;
    Country            = country;
    PurchaseBlock      = purchase_block;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}