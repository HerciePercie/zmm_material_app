projection;
strict ( 2 );
use draft;

define behavior for ZPAL_C_JE_HEAD alias JournalEntry
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { create; with draft; }
}

define behavior for ZPAL_C_JE_ITEM alias JournalEntryItem
{
  use update;
  use delete;

  use association _Header;
}