projection;
strict ( 2 );
use draft;

define behavior for ZC_SD_SO_HEAD alias SalesOrder
{
  use create;
  use update;
  use delete;

  use action approveOrder;
  use action shipOrder;
  use action cancelOrder;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { create; with draft; }
  use association _Customer;
}

define behavior for ZC_SD_SO_ITEM alias OrderItem
{
  use update;
  use delete;

  use association _Header;
  use association _Material;
}