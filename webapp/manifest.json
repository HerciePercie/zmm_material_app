{
  "_version": "1.86.0",
  "sap.app": {
    "id": "pala.erp.zmmmaterialapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "3cc38010-2fb3-42f8-85ef-9732f81b67b6"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mm_material_o4_bind/srvd/sap/zui_mm_material_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.7",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pala.erp.zmmmaterialapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MaterialList",
          "target": "MaterialList"
        },
        {
          "pattern": "Material({key}):?query:",
          "name": "MaterialObjectPage",
          "target": "MaterialObjectPage"
        },
        {
          "pattern": "Material({key})/_StockMovements({key2}):?query:",
          "name": "StockMovementObjectPage",
          "target": "StockMovementObjectPage"
        }
      ],
      "targets": {
        "MaterialList": {
          "type": "Component",
          "id": "MaterialList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Material",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Material": {
                  "detail": {
                    "route": "MaterialObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "btnCreateMaterial": {
                      "press": ".extension.pala.erp.zmmmaterialapp.ext.controller.MaterialListCustom.onOpenCreateDialog",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Yeni Malzeme Ekle"
                    }
                  }
                }
              }
            }
          }
        },
        "MaterialObjectPage": {
          "type": "Component",
          "id": "MaterialObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Material",
              "navigation": {
                "_StockMovements": {
                  "detail": {
                    "route": "StockMovementObjectPage"
                  }
                }
              }
            }
          }
        },
        "StockMovementObjectPage": {
          "type": "Component",
          "id": "StockMovementObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Material/_StockMovements"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "pala.erp.zmmmaterialapp.ext.controller.MaterialListCustom"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}